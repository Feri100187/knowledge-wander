# Knowledge Wander environment template
# Copy this file to .env / .env.local as appropriate.
# Never commit real API keys or secrets.

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend / LLM
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=25
LLM_TEMPERATURE=0.7
LLM_CANDIDATE_COUNT=12
LLM_MAX_TOKENS=3000
LLM_JSON_MODE=false
# Optional: low / medium / high. Only enable when the configured provider/model supports it.
LLM_REASONING_EFFORT=

# Optional application settings
APP_ENV=development
FRONTEND_ORIGIN=
PORT=8000

# Backend / Feedback
FEEDBACK_DB_PATH=

# Backend / Public book APIs
OPENLIBRARY_BASE_URL=https://openlibrary.org
OPENLIBRARY_CONTACT_EMAIL=
OPENLIBRARY_TIMEOUT_SECONDS=15

GOOGLE_BOOKS_BASE_URL=https://www.googleapis.com/books/v1
GOOGLE_BOOKS_API_KEY=
GOOGLE_BOOKS_TIMEOUT_SECONDS=15

BOOK_SEARCH_CACHE_TTL_SECONDS=600
BOOK_SEARCH_CACHE_MAX_ENTRIES=200
BOOK_SEARCH_ENGLISH_CACHE_TTL_SECONDS=2700
BOOK_SEARCH_ENGLISH_CACHE_MAX_ENTRIES=200
